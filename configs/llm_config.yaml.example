# ============================================================================
# LLM 统一大模型提供商与路由配置 — 模板文件
# ============================================================================
# 使用说明：
#   1. 将此文件复制为 llm_config.yaml
#   2. 填入真实的 base_url 与 api_key
#   3. llm_config.yaml 已在 .gitignore 中排除，不会被提交到版本库
#
# 支持 ${ENV_VAR} 语法从环境变量中加载密钥凭证（推荐生产环境使用）
# ============================================================================

providers:
  # 🟢 本地离线推理服务 (Ollama)
  ollama:
    type: "ollama"
    base_url: "http://127.0.0.1:11434"
    api_key: ""
    models:
      - name: "gemma3:12b"
        tier: "sentinel"
        display_name: "Gemma 3 (本地离线 / 12B)"
      - name: "qwen3:14b"
        tier: "sentinel"
        display_name: "通义千问 3 (本地离线 / 14B)"

  # 🔵 线上 DeepSeek 官方 API (兼容 OpenAI 接口协议)
  deepseek:
    type: "openai_compatible"
    base_url: "https://api.deepseek.com"
    api_key: "${DEEPSEEK_API_KEY}"     # 替换为真实 Key，或设置环境变量
    models:
      - name: "deepseek-chat"
        tier: "value"
        display_name: "DeepSeek Chat (极速 / 降本首选)"
      - name: "deepseek-reasoner"
        tier: "premium"
        display_name: "DeepSeek Reasoner (高保真 / 旗舰思考)"

  # 🟡 OpenAI 官方 API（示例）
  # openai:
  #   type: "openai_compatible"
  #   base_url: "https://api.openai.com/v1"
  #   api_key: "${OPENAI_API_KEY}"
  #   models:
  #     - name: "gpt-4o"
  #       tier: "premium"
  #       display_name: "GPT-4o"

  # 🟠 自发现演示 Mock（开发测试用，可删除）
  # mock_test_provider:
  #   type: "mock_test"
  #   models:
  #     - name: "mock-auto-model"
  #       tier: "sentinel"
  #       display_name: "Mock 自动发现模型"

# ============================================================================
# 全局大模型调度配置
# ============================================================================
api_concurrency_limit: 1     # 同时执行的 LLM 任务上限（设为 2+ 便于并发排队测试）
